# Directories to ignore
**/node_modules/
**/vendor/
# storage/framework, storage/logs, bootstrap/cache: Laravel can cac thu muc nay ton tai
# (thieu la composer install loi package:discover). Noi dung da duoc bo qua bang .gitignore ben trong.

# Files to ignore
**/.env
**/.DS_Store
**/storage/*.key
Thumbs.db

# Large binaries/Models
**/public/models/*.shard*
**/public/models/*.json

# Windows setup
.tools/
QLNS/.env.mac.bak
QLNS/package-lock.mac.json
